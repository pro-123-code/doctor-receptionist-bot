{
  "name": "doctor-receptionist-bot",
  "version": "0.1.0",
  "private": true,
  "description": "A WhatsApp receptionist for private clinics, with a per-clinic web dashboard.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check": "node --check src/server.js",
    "smoke": "node test/smoke-startup.js",
    "dashboard:check": "node test/dashboard-contract.js",
    "dashboard:runtime": "node test/dashboard-runtime.js",
    "verify:deploy": "node scripts/verify-deployment.js",
    "test": "node --test",
    "build:dashboard": "tailwindcss -i ./src/dashboard.css -o ./src/dashboard-built.css --minify",
    "dashboard:css": "node test/dashboard-css.js",
    "self:check": "node scripts/self-check.js",
    "audit": "npm audit --audit-level=high",
    "verify": "npm run check && npm run smoke && npm run dashboard:check && npm run build:dashboard && npm run dashboard:css && npm run dashboard:runtime && npm test"
  },
  "engines": {
    "node": "^20.19.0"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@whiskeysockets/baileys": "^6.7.18",
    "chrono-node": "^2.10.1",
    "date-holidays": "^3.37.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "googleapis": "^144.0.0",
    "mongoose": "^9.10.3",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.13",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  },
  "license": "UNLICENSED"
}
