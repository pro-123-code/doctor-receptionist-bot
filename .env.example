# Local server
PORT=3000
NODE_ENV=development
DOCTOR_ID=your-doctor-id
CLINIC_ID=your-clinic-id
DOCTOR_NAME=your-doctor-name
CLINIC_NAME=your-clinic-name
FACILITIES_LIST=facility-one|facility-two
WELCOME_MESSAGE=your clinic welcome message

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/doctorbot?retryWrites=true&w=majority

# Gemini. Keep patient-data processing disabled until privacy/compliance approval.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ALLOW_PHI_PROCESSING=false

# Baileys session files should remain private and excluded from source control.
# Optional private session root. Defaults to the current user's local application data directory.
# BAILEYS_AUTH_DIR=path/to/private/sessions

# In production, expose the health server only behind an HTTPS-terminating proxy.
TRUST_PROXY=false

# Google Calendar OAuth2 and appointment settings.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-google-oauth-refresh-token
GOOGLE_REDIRECT_URI=https://your-domain.example/api/auth/google/callback
GOOGLE_CALENDAR_ID=primary
GOOGLE_TIME_ZONE=Asia/Karachi
APPOINTMENT_DURATION_MINUTES=30
APPOINTMENT_LOOKAHEAD_DAYS=7
OFFICE_START_HOUR=9
OFFICE_END_HOUR=17

# Daily Excel report. Cron uses the clinic's timezone.
DAILY_REPORT_TIME_ZONE=Asia/Karachi
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=your-smtp-user
SMTP_PASS=replace-with-your-smtp-password
EMAIL_FROM=DoctorBot <reception@example.com>
DOCTOR_EMAIL=doctor@example.com

# Dashboard login. Use a long, unique cookie secret (at least 32 characters).
DASHBOARD_EMAIL=doctor@example.com
DASHBOARD_PASSWORD=replace-with-a-strong-password
DASHBOARD_COOKIE_SECRET=replace-with-at-least-32-random-characters
DASHBOARD_SESSION_SECRET=replace-with-64-random-hex-characters

# SaaS administrator bootstrap and per-doctor credential encryption.
SUPERADMIN_EMAIL=owner@example.com
SUPERADMIN_PASSWORD=replace-with-a-unique-12-character-minimum-password
DOCTOR_CONFIG_ENCRYPTION_KEY=replace-with-64-hex-characters-from-openssl-rand-hex-32
